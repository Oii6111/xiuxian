# ===== 视觉模型配置（OpenAI 兼容接口）=====
# 密钥三者任选其一即可，优先级：LLM_API_KEY > OPENAI_API_KEY > DASHSCOPE_API_KEY
LLM_API_KEY=
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=

# 默认走阿里云百炼 DashScope（国内可直连，无需代理）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-vl-plus

# 注意：如果你的密钥是「工作空间密钥」（sk-ws- 开头），
# 请把 LLM_BASE_URL 改成控制台里给的工作空间专属地址，例如：
# LLM_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 换成 OpenAI 视觉：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 换成本地 vLLM / Ollama 等 OpenAI 兼容服务（离线可用）：
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=qwen2.5-vl-7b-instruct

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
