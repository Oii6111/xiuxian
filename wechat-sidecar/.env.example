# ===== 老人端微信健康助手 环境变量模板 =====
# 复制为 .env 再填真实值；真实 .env 含密钥，千万不要提交到仓库。

# --- DeepSeek 模型（文字聊天 + 视觉，默认供应商）---
DEEPSEEK_API_KEY=填写_DeepSeek_Key
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash

HEALTH_CHAT_ENABLED=true
HEALTH_CHAT_BASE_URL=https://api.deepseek.com
HEALTH_CHAT_API_KEY=同_DEEPSEEK_API_KEY
HEALTH_CHAT_MODEL=deepseek-chat
# MEDICAL_* 留空会复用 HEALTH_CHAT_*；想用更谨慎的医疗模型再单独填
# MEDICAL_BASE_URL=
# MEDICAL_API_KEY=
# MEDICAL_MODEL=

# --- 视觉（药盒 / 体检单识别）---
VISION_BASE_URL=https://api.deepseek.com
VISION_API_KEY=同_DEEPSEEK_API_KEY
VISION_MODEL=deepseek-flash

# --- 侧车内部令牌（hook 与侧车互认，本地开发可留空，生产建议设置）---
ELDER_SIDECAR_TOKEN=

# --- 可选：OpenClaw Gateway 对话润色（默认关）---
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_MODEL=
# OPENCLAW_AGENT_ID=

# --- 可选：把已确认事件转发给家庭端 / 后台 ---
# HEALTH_EVENT_SINK_URL=
# HEALTH_EVENT_SINK_TOKEN=

# --- 游戏任务桥接（game_task_bridge.py 用）---
GAME_API_BASE=http://127.0.0.1:8080
HEALTH_SERVICE_TOKEN=与游戏侧_HEALTH_SERVICE_TOKEN_一致
BINDING_ID=binding_xxx
ELDER_ID=elder_demo_001

# --- OpenClaw 出站发送（提醒 / 回执用）---
OPENCLAW_SEND_CHANNEL=openclaw-weixin
OPENCLAW_SEND_TARGET=老人_ilink_user_id

# --- 调度器（可选）---
# ELDER_MEAL_SCHEDULE=
# ELDER_MOVE_SCHEDULE=
# OPENCLAW_DRY_RUN=1   试跑：只打印，不发送、不提交

# --- 服务端口 ---
HOST=127.0.0.1
PORT=8001
