# Godot 4+ specific ignores
.godot/
/android/

# Export credentials and local environment settings.
export_credentials.cfg
.env
.env.*
!.env.example

# Plugin updater state and backups.
/addons/.godot_ai_update/

# Player progress, test output, logs, and local backups.
/output/*.json
/output/backups/
/output/pixel-screenshot.png
/output/pixel-screenshot.png.import
*.log

# Python bridge caches and interrupted local writes.
__pycache__/
*.pyc
/output/*.tmp

# Operating system files.
.DS_Store
Thumbs.db
Desktop.ini

# Account password database, sessions and per-account progress.
/server/account/data/
/output/accounts/

# Preserve main branch campaign and local output exclusions.
/work/
/outputs/*
!/outputs/.gdignore
/build/
/output/a-backend-*/
/output/account-test-*/
