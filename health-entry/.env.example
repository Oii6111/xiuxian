# ===== 视觉模型配置（OpenAI 兼容接口）=====
# 密钥三者任选其一即可，优先级：LLM_API_KEY > OPENAI_API_KEY > DASHSCOPE_API_KEY
LLM_API_KEY=
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=

# 默认走阿里云百炼 DashScope（国内可直连，无需代理）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-vl-plus

# 模型网络路由：auto 对通义千问直连；true 使用系统代理；false 强制直连。
# 不修改 Windows 全局代理，HTTPS 证书校验始终启用。
LLM_USE_SYSTEM_PROXY=auto

# 使用工作空间专属接入点时，以控制台给出的地址为准。
# 不要仅凭密钥前缀判断是否需要切换地址。例如：
# LLM_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 换成 OpenAI 视觉：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 换成本地 vLLM / Ollama 等 OpenAI 兼容服务（离线可用）：
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=qwen2.5-vl-7b-instruct

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
