# 仅用于本地；复制为 .env 后填写，真实值不得提交。
HOST=127.0.0.1
PORT=8001
ELDER_SIDECAR_TOKEN=
GAME_REVIEW_TOKEN=
GAME_API_BASE=http://127.0.0.1:8080
HEALTH_SERVICE_TOKEN=
# 绑定完成后填 JSON 数组；完整字段见 docs/TASK_REMINDER_BRIDGE.md。
ELDER_BINDINGS=[]
OPENCLAW_DRY_RUN=1
OPENCLAW_SEND_CHANNEL=openclaw-weixin
# OPENCLAW_BIN=
# ELDER_DB_PATH=
# BRIDGE_STATE=

# 模型由 D 配置；不填 DEEPSEEK_API_KEY 或不开 HEALTH_CHAT_ENABLED 时，
# 老人发消息只会收到固定兜底话术（"哎，你来啦…" / "照片收到了…"），这是常见坑。
HEALTH_CHAT_ENABLED=false
DEEPSEEK_API_KEY=
# 文本模型：DEEPSEEK_CHAT_MODEL 优先于 HEALTH_CHAT_MODEL；灵宠那边用的是 deepseek-flash。
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
HEALTH_CHAT_API_KEY=
HEALTH_CHAT_BASE_URL=https://api.deepseek.com
HEALTH_CHAT_MODEL=deepseek-flash
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
# 健康域内部事件 sink，不能填写 C 的游戏 task-results 地址。
# 指向本侧车自身：老人确认的完成反馈经此路由提交给 C。
# HEALTH_EVENT_SINK_URL=http://127.0.0.1:8000/internal/v1/game/health-events
# HEALTH_EVENT_SINK_TOKEN=
ILINK_API_BASE=https://ilinkai.weixin.qq.com
