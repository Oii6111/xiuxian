# Companion chat service configuration.
# Keep this file UTF-8 with normal line breaks; never paste a variable at the end
# of a comment line, or the parser will treat it as part of the comment.
#
# Copy to .env and fill LLM_API_KEY. .env is gitignored.

# DeepSeek API key (server-side only; never ship it to Godot or the browser).
LLM_API_KEY=

# OpenAI-compatible endpoint and model.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# Seconds; must stay below the client's 15s budget.
LLM_TIMEOUT=20

# auto / true / false. false ignores system proxy settings.
LLM_USE_SYSTEM_PROXY=auto

# Listener.
HOST=127.0.0.1
PORT=8031

# Empty: only loopback requests accepted. Set: require "Authorization: Bearer <token>".
COMPANION_SERVICE_TOKEN=

# Force offline replies without calling the model (useful for demos and tests).
# COMPANION_PROVIDER=stub
